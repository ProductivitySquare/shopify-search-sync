{%- comment -%}
  Example integration. Paste the trigger button wherever your search
  icon currently lives in the theme (usually inside header.liquid or
  a section named something like "header"), and paste the <script>
  tag once, right before </body> in theme.liquid.

  Replace YOUR_SEARCH_ONLY_KEY with your real Algolia search-only key —
  it's safe to expose in the page source, it can only read the index,
  not write to it. The App ID (NTC7X15L5E) is also public by design.
{%- endcomment -%}

<button id="hv-search-trigger" aria-label="Search" class="header__icon">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="7"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
  </svg>
</button>

<script
  src="{{ 'hv-search-widget.js' | asset_url }}"
  defer
  data-algolia-app-id="NTC7X15L5E"
  data-algolia-search-key="YOUR_SEARCH_ONLY_KEY"
  data-index="products"
  data-trigger-selector="#hv-search-trigger"
></script>
